<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LLM Token 价格追踪 — {{ date }}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans SC", sans-serif;
            background: #f8f9fa; color: #333; line-height: 1.6;
        }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        header {
            background: linear-gradient(135deg, #0c8c3c 0%, #1a5c2a 100%);
            color: white; padding: 40px 20px; text-align: center;
            border-radius: 0 0 20px 20px; margin-bottom: 24px;
        }
        header h1 { font-size: 26px; margin-bottom: 6px; }
        header p { opacity: 0.85; font-size: 14px; }
        .highlight-box {
            background: white; border-radius: 12px; padding: 20px;
            margin-bottom: 20px; box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        }
        .highlight-box h2 { font-size: 18px; margin-bottom: 12px; color: #1a5c2a; }
        .arbitrage-card {
            display: inline-block; background: #fff8e1; border: 1px solid #ffc107;
            border-radius: 8px; padding: 12px 20px; margin: 6px;
            font-size: 14px;
        }
        .arbitrage-card strong { color: #e65100; }
        .filters {
            display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 16px;
        }
        .filter-btn {
            padding: 6px 16px; border: 1.5px solid #ddd;
            background: white; border-radius: 20px;
            cursor: pointer; font-size: 13px; transition: all 0.2s;
        }
        .filter-btn:hover, .filter-btn.active {
            background: #0c8c3c; color: white; border-color: #0c8c3c;
        }
        table {
            width: 100%; border-collapse: collapse; background: white;
            border-radius: 12px; overflow: hidden; box-shadow: 0 1px 4px rgba(0,0,0,0.06);
            font-size: 13px;
        }
        th {
            background: #f1f3f5; padding: 12px 14px; text-align: left;
            font-weight: 600; color: #555; white-space: nowrap;
            position: sticky; top: 0; z-index: 1;
        }
        td { padding: 10px 14px; border-bottom: 1px solid #f0f0f0; }
        tr:hover { background: #fafbfc; }
        .price-free { color: #0c8c3c; font-weight: 700; }
        .price-low { color: #1b5e20; font-weight: 600; }
        .price-mid { color: #e65100; }
        .price-high { color: #c62828; font-weight: 600; }
        .cn-badge { 
            display: inline-block; background: #ffebee; color: #c62828;
            padding: 1px 6px; border-radius: 3px; font-size: 11px;
            margin-left: 4px;
        }
        .tag {
            display: inline-block; padding: 2px 8px; border-radius: 10px;
            font-size: 11px; background: #e8f5e9; color: #2e7d32;
            margin: 1px;
        }
        .change-up { color: #c62828; }
        .change-down { color: #0c8c3c; }
        .arbitrage-note {
            background: #fff3e0; padding: 4px 8px; border-radius: 4px;
            font-size: 11px; color: #e65100; white-space: nowrap;
        }
        .search-box {
            width: 100%; max-width: 400px; padding: 8px 16px;
            border: 1.5px solid #ddd; border-radius: 20px; font-size: 14px;
            margin-bottom: 12px; outline: none;
        }
        .search-box:focus { border-color: #0c8c3c; }
        footer {
            text-align: center; padding: 30px; color: #aaa; font-size: 12px;
        }
        .stat-row {
            display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 16px;
        }
        .stat-card {
            background: white; border-radius: 8px; padding: 14px 20px;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06); flex: 1; min-width: 180px;
            text-align: center;
        }
        .stat-card .num { font-size: 22px; font-weight: 700; }
        .stat-card .label { font-size: 12px; color: #888; }
        .change-list { margin-top: 12px; }
        .change-item {
            padding: 8px 12px; border-bottom: 1px solid #f0f0f0;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <header>
        <h1>🪙 LLM Token 价格追踪</h1>
        <p>{{ date }} · 数据来源 OpenRouter API · 共追踪 {{ total_models }} 个模型</p>
    </header>

    <div class="container">
        <!-- 套利提示 -->
        {% if arbitrage_examples %}
        <div class="highlight-box">
            <h2>🔍 今日套利发现（国产模型 vs 海外同级别模型）</h2>
            {% for item in arbitrage_examples %}
            <div class="arbitrage-card">
                {{ item.cn_model | truncate(30) }} → 
                比 {{ item.us_model | truncate(30) }} 
                便宜 <strong>{{ item.ratio }}x</strong>
            </div>
            {% endfor %}
        </div>
        {% endif %}

        <!-- 价格变动 -->
        {% if changes %}
        <div class="highlight-box">
            <h2>📢 价格变动（24h）</h2>
            <div class="change-list">
            {% for c in changes %}
            <div class="change-item">
                <span class="{% if c.direction == 'up' %}change-up{% else %}change-down{% endif %}">
                    {{ '📈' if c.direction == 'up' else '📉' }}
                </span>
                <strong>{{ c.name }}</strong> {{ c.provider_label }}
                输入: ${{ "%.3f"|format(c.old_input) }} → ${{ "%.3f"|format(c.new_input) }}
                输出: ${{ "%.3f"|format(c.old_output) }} → ${{ "%.3f"|format(c.new_output) }}
            </div>
            {% endfor %}
            </div>
        </div>
        {% endif %}

        <!-- 统计卡片 -->
        <div class="stat-row">
            <div class="stat-card">
                <div class="num">{{ stats.cheapest_input }}</div>
                <div class="label">💰 最低输入价格 ($/M tokens)</div>
            </div>
            <div class="stat-card">
                <div class="num">{{ stats.cn_model_count }}</div>
                <div class="label">🇨🇳 国产模型</div>
            </div>
            <div class="stat-card">
                <div class="num">{{ stats.free_model_count }}</div>
                <div class="label">🆓 免费模型</div>
            </div>
            <div class="stat-card">
                <div class="num">{{ stats.cn_vs_us_ratio }}x</div>
                <div class="label">🇨🇳 vs 🇺🇸 平均价差</div>
            </div>
        </div>

        <!-- 搜索 + 筛选 -->
        <input type="text" class="search-box" placeholder="🔍 搜索模型名称..." oninput="filterTable()" id="searchInput">
        <div class="filters">
            <button class="filter-btn active" onclick="filterCategory('all', this)">全部</button>
            <button class="filter-btn" onclick="filterCategory('llm', this)">💬 语言模型</button>
            <button class="filter-btn" onclick="filterCategory('code', this)">💻 代码</button>
            <button class="filter-btn" onclick="filterCategory('vision', this)">👁 视觉</button>
            <button class="filter-btn" onclick="filterCategory('video', this)">🎬 视频</button>
            <button class="filter-btn" onclick="filterCategory('audio', this)">🎵 音频</button>
        </div>

        <!-- 价格表 -->
        <table id="priceTable">
            <thead>
                <tr>
                    <th>模型</th>
                    <th>提供商</th>
                    <th>输入 ($/1M tokens)</th>
                    <th>输出 ($/1M tokens)</th>
                    <th>上下文窗口</th>
                    <th>类别</th>
                </tr>
            </thead>
            <tbody>
                {% for m in models %}
                <tr data-category="{{ m.category }}" data-search="{{ m.display_name.lower() }} {{ m.model_id.lower() }} {{ m.provider_label.lower() }}">
                    <td>
                        <a href="{{ m.source_url }}" target="_blank" rel="noopener" style="color:#1a0dab;text-decoration:none;">
                            {{ m.display_name[:50] }}
                        </a>
                        {% if '🇨🇳' in m.provider_label %}<span class="cn-badge">国产</span>{% endif %}
                    </td>
                    <td>{{ m.provider_label }}</td>
                    <td class="{% if m.is_free %}price-free{% elif m.input_price_usd < 0.5 %}price-low{% elif m.input_price_usd < 3 %}price-mid{% else %}price-high{% endif %}">
                        {% if m.is_free %}免费{% else %}${{ "%.3f"|format(m.input_price_usd) }}{% endif %}
                    </td>
                    <td class="{% if m.is_free %}price-free{% elif m.output_price_usd < 1 %}price-low{% elif m.output_price_usd < 8 %}price-mid{% else %}price-high{% endif %}">
                        {% if m.is_free %}免费{% else %}${{ "%.3f"|format(m.output_price_usd) }}{% endif %}
                    </td>
                    <td>{{ m.context_window | format_number }}</td>
                    <td><span class="tag">{{ m.category }}</span></td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <footer>
        <p>数据来源：OpenRouter API · 每日自动更新 · 仅供研究参考</p>
        <p><a href="https://github.com" style="color:#aaa;">View on GitHub</a></p>
    </footer>

    <script>
        let currentCategory = 'all';
        function filterCategory(cat, btn) {
            currentCategory = cat;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            filterTable();
        }
        function filterTable() {
            const search = (document.getElementById('searchInput').value || '').toLowerCase();
            document.querySelectorAll('#priceTable tbody tr').forEach(row => {
                const cat = row.dataset.category || '';
                const txt = row.dataset.search || '';
                const catMatch = currentCategory === 'all' || cat === currentCategory;
                const searchMatch = !search || txt.includes(search);
                row.style.display = (catMatch && searchMatch) ? '' : 'none';
            });
        }
    </script>
</body>
</html>
